---
export interface Props {
  lang: 'es' | 'en';
}

import { useTranslations } from '../../../i18n/utils';
import img1 from "./img/img1.png";
import img2 from "./img/img2.png";
import img3 from "./img/img3.png";

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="info-section">
    <h2 set:html={t('exercise2.info.title')} />

    <p set:html={t('exercise2.info.para1')} />
    <p set:html={t('exercise2.info.para2')} />
    <p set:html={t('exercise2.info.para3')} />

    <img
        src={img1.src}
        alt="Aparato experimental de flujo a través de arena"
        class="info-image"
    />

    <p set:html={t('exercise2.info.para4')} />

    <p class="formula">
        <b>i = ∆h / ∆L</b>
    </p>

    <p set:html={t('exercise2.info.para5')} />

    <img
        src={img2.src}
        alt="Medición de alturas h₁ y h₂ en piezómetros"
        class="info-image"
    />

    <p set:html={t('exercise2.info.para6')} />
    <p set:html={t('exercise2.info.para7')} />

    <img
        src={img3.src}
        alt="Casos de inclinación y dirección del flujo"
        class="info-image"
    />

    <p set:html={t('exercise2.info.para8')} />
</div>

<style>
    .info-section {
        background-color: var(--cardMario);
        color: var(--titles);
        border-radius: 1rem;
        border: 1px solid var(--rayas);
        box-shadow: 0 4px 12px var(--shadow);
        padding: 1.5rem;
        margin-bottom: 2rem;
        line-height: 1.7;
        transition:
            background-color 0.3s ease,
            color 0.3s ease,
            box-shadow 0.3s ease;
    }

    .info-section h2 {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--pepe);
    }

    .info-section h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: var(--titles);
    }

    .info-section p {
        margin-bottom: 0.8rem;
    }

    .info-section ol {
        padding-left: 1.5rem;
    }

    .info-section ol li {
        margin-bottom: 0.4rem;
    }

    .info-section .formula {
        font-family: monospace;
        background: var(--titlesnt);
        border: 1px solid var(--rayas);
        padding: 0.6rem 1rem;
        border-radius: 0.5rem;
        text-align: center;
        margin: 1rem 0;
        color: var(--titles);
    }

    .info-section .image-placeholder {
        width: 100%;
        height: 14rem;
        background-color: var(--titlesnt);
        border: 1px dashed var(--rayas);
        border-radius: 0.5rem;
        color: var(--titles);
        font-style: italic;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 1.2rem 0;
    }
</style>
